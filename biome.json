{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "client/src/**",
      "server/**",
      "shared/**",
      "scripts/**",
      "*.ts",
      "*.mjs",
      "*.js",
      "*.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnreachable": "error",
        "noInvalidBuiltinInstantiation": "error",
        "useIsNan": "error",
        "noSelfAssign": "error",
        "noConstantCondition": "error",
        "noSwitchDeclarations": "error"
      },
      "suspicious": {
        "noAsyncPromiseExecutor": "error",
        "noDuplicateCase": "error",
        "noDuplicateObjectKeys": "error",
        "noShadowRestrictedNames": "error",
        "noMisleadingCharacterClass": "error",
        "noGlobalIsNan": "error",
        "noRedeclare": "error",
        "noDoubleEquals": {
          "level": "error",
          "options": {
            "ignoreNull": true
          }
        },
        "noExplicitAny": "warn",
        "useAwait": "warn"
      },
      "complexity": {
        "noBannedTypes": "error",
        "noUselessTypeConstraint": "error"
      },
      "style": {
        "useNodejsImportProtocol": "error",
        "useNumberNamespace": "error",
        "useTemplate": "error"
      },
      "performance": {
        "noAccumulatingSpread": "error"
      },
      "security": {
        "noGlobalEval": "error"
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/test/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
